# Admin
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-32-byte-hex-key

# Optional persistent storage for admin-managed API keys
POSTGRES_URL=

# Optional bootstrap pool. JSON array with at most 20 entries.
# Example: [{"provider":"gemini","key":"...","enabled":true}]
AI_KEYS_JSON=[]

# Provider defaults
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
MAX_FILE_MB=50

# Event-driven webhooks
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GITHUB_WEBHOOK_SECRET=replace-with-a-long-github-webhook-secret

# Vercel Blob and event queue
BLOB_READ_WRITE_TOKEN=
MAX_CONCURRENT_JOBS=2
